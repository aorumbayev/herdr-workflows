{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "herdr-workflows",
  "version": "0.0.0-development",
  "private": true,
  "description": "Linear v1alpha1 YAML workflow runner for herdr — agent, run, herdr, and workflow actions.",
  "keywords": [
    "agent",
    "ai",
    "herdr-plugin",
    "workflow",
    "yaml"
  ],
  "homepage": "https://github.com/aorumbayev/herdr-workflows",
  "bugs": {
    "url": "https://github.com/aorumbayev/herdr-workflows/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorumbayev/herdr-workflows.git"
  },
  "bin": {
    "herdr-workflows": "./src/cli.ts",
    "hwf": "./src/cli.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test ./test",
    "schema": "bun scripts/generate-schema.ts",
    "examples": "bun scripts/generate-examples.ts",
    "schema:herdr": "bun scripts/generate-herdr-methods.ts",
    "build": "bun build --compile --outfile=bin/herdr-workflows src/cli.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "install:dev": "bun run build && bun scripts/install-dev.ts",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepare": "git config core.hooksPath .githooks",
    "verify:lint": "verifyx lint -- --max-warnings=0",
    "verify:format": "verifyx format",
    "verify:check-types": "verifyx check-types",
    "verify": "verifyx --no-tests",
    "verify:unused-code": "verifyx unused-code",
    "verify:duplicate-code": "verifyx duplicate-code",
    "verify:comments": "verifyx comments --pushback",
    "verify:prose": "bun scripts/verify-prose.ts",
    "verify:no-archive": "bun scripts/verify-no-archive.ts",
    "verify:layers": "bun scripts/verify-layers.ts",
    "verify:file-length": "bun scripts/verify-file-length.ts",
    "verify:hardcoded-colors": "verifyx hardcoded-colors && verifyx hardcoded-colors --root docs/.vitepress/theme"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "commander": "15.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@makerx/verify": "1.3.0-beta.15",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "jscpd": "5.0.14",
    "knip": "6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "semantic-release": "25.0.8",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  }
}
