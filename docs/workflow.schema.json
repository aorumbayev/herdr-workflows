{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "const": "text"
          },
          {
            "type": "string",
            "const": "profile"
          },
          {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["text", "choice", "profile"]
              },
              "description": {
                "type": "string"
              },
              "default": {
                "type": "string"
              },
              "options": {
                "anyOf": [
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  {
                    "type": "object",
                    "properties": {
                      "run": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": ["run"],
                    "additionalProperties": false
                  }
                ]
              },
              "when": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "allow_custom": {
                "type": "boolean"
              },
              "min_length": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "returns": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "on_failure": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "using": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "shell": {
          "type": "string",
          "enum": ["sh", "bash", "zsh", "pwsh", "powershell", "cmd"]
        },
        "herdr": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "workflow": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "pane": {
          "type": "object",
          "properties": {
            "open": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["tab", "beside", "below"]
                },
                {
                  "type": "string",
                  "pattern": "^\\{\\{\\s*((?:inputs|steps|context)(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\s*\\}\\}$"
                }
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "workspace": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "focus": {
              "type": "boolean"
            },
            "close": {
              "type": "string",
              "enum": ["success", "always"]
            }
          },
          "required": ["open"],
          "additionalProperties": false
        },
        "ready_when": {
          "type": "string"
        },
        "timeout": {
          "type": "string",
          "pattern": "^([1-9]\\d*)(ms|s|m|h)$"
        },
        "success_codes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "id": {},
        "when": {},
        "continue_on_error": {},
        "background": {},
        "retry": {}
      },
      "additionalProperties": {}
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "when": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "continue_on_error": {
            "type": "boolean"
          },
          "agent": {
            "type": "string"
          },
          "using": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "shell": {
            "type": "string",
            "enum": ["sh", "bash", "zsh", "pwsh", "powershell", "cmd"]
          },
          "herdr": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "workflow": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "pane": {
            "type": "object",
            "properties": {
              "open": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["tab", "beside", "below"]
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{\\{\\s*((?:inputs|steps|context)(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)+)\\s*\\}\\}$"
                  }
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "workspace": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "focus": {
                "type": "boolean"
              },
              "close": {
                "type": "string",
                "enum": ["success", "always"]
              }
            },
            "required": ["open"],
            "additionalProperties": false
          },
          "ready_when": {
            "type": "string"
          },
          "timeout": {
            "type": "string",
            "pattern": "^([1-9]\\d*)(ms|s|m|h)$"
          },
          "success_codes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "background": {
            "type": "boolean"
          },
          "retry": {
            "type": "object",
            "properties": {
              "attempts": {
                "type": "integer",
                "minimum": 2,
                "maximum": 9007199254740991
              },
              "delay": {
                "type": "string",
                "pattern": "^([1-9]\\d*)(ms|s|m|h)$"
              }
            },
            "required": ["attempts"],
            "additionalProperties": false
          }
        },
        "additionalProperties": {}
      }
    }
  },
  "required": ["version", "steps"],
  "additionalProperties": false,
  "$id": "https://raw.githubusercontent.com/aorumbayev/herdr-workflows/main/docs/workflow.schema.json",
  "title": "herdr-workflows workflow",
  "description": "Linear YAML workflow for the herdr-workflows herdr plugin (format v1alpha1). Cross-field rules are enforced by the parser and loader, not this schema."
}
