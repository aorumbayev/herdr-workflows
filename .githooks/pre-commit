#!/usr/bin/env sh
set -e
cd "$(git rev-parse --show-toplevel)"

go test -race $(go list ./... | grep -v '/e2e$')

if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run
else
  echo "pre-commit: skipping golangci-lint (not on PATH)" >&2
fi

for script in verify-prose verify-no-archive verify-file-length verify-comments; do
  if [ -d "scripts/${script}" ] || [ -f "scripts/${script}/main.go" ]; then
    go run "./scripts/${script}"
  fi
done
